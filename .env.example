# ===== Adsterra 广告配置（复制本文件为 .env.local 后填写）=====
# 只接 Banner / Native Banner，不要接 Popunder / Social Bar / Push / Interstitial / Direct Link
# 把下面的 1234567 换成你在 Adsterra 后台拿到的真实 zone / container id 与脚本地址

# ---------- 顶部 Banner（横幅广告）----------
# 开启该广告位
NEXT_PUBLIC_ADSTERRA_BANNER_ENABLED=true
# Adsterra 代码里的容器 id（通常形如 container-1234567）
NEXT_PUBLIC_ADSTERRA_BANNER_CONTAINER=container-1234567
# 方式 A：如果你拿到的代码是 <script async src="https://cdn.adsterra.com/.../xxx.js">
# 则填下面这行，并把 _SCRIPT 留空
NEXT_PUBLIC_ADSTERRA_BANNER_SRC=https://cdn.adsterra.com/XXXXXXX/YYYYYYY.js
# 方式 B：如果你拿到的是经典内联 JS（如 (function(d,z,s){...})('cdn.adsterra.com',1234567,...) ）
# 则填下面这行，并把 _SRC 留空
NEXT_PUBLIC_ADSTERRA_BANNER_SCRIPT=(function(d,z,s){s.src='https://'+d+'/400/'+z;try{(document.body||document.documentElement).appendChild(s)}catch(e){}})('cdn.adsterra.com',1234567,document.createElement('script'));

# ---------- 底部 Native Banner（原生广告）----------
NEXT_PUBLIC_ADSTERRA_NATIVE_ENABLED=true
NEXT_PUBLIC_ADSTERRA_NATIVE_CONTAINER=native-container-1234567
# Native Banner 通常给的是异步脚本地址
NEXT_PUBLIC_ADSTERRA_NATIVE_SRC=https://cdn.adsterra.com/native/1234567.js
NEXT_PUBLIC_ADSTERRA_NATIVE_SCRIPT=
